# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_LOG_LEVEL=INFO

# PostgreSQL + PostGIS
DATABASE_URL=postgis://findme:findme@localhost:5432/findme
DATABASE_CONN_MAX_AGE=60

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Выполнять задачи синхронно в dev, без запущенного воркера
CELERY_TASK_ALWAYS_EAGER=False

# GeoDjango: раскомментировать, если библиотеки не находятся автоматически
# (macOS/homebrew: brew install gdal geos proj)
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# Telegram
TELEGRAM_BOT_TOKEN=

# S3-совместимое хранилище (нужно только для production)
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-central1

# Домен
PUBLIC_LOCATION_BLUR_M=250
NOTIFICATIONS_DAILY_CAP=15
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Только для production-настроек
CSRF_TRUSTED_ORIGINS=
